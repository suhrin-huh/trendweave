# OpenAI 모드를 사용하는 경우 .env 파일에 본인의 API 키를 입력하세요.
OPENAI_API_KEY=

# LangSmith를 사용하지 않으면 false를 유지하세요.
LANGCHAIN_TRACING_V2=false

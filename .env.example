# OpenAI 모드를 사용하는 경우 .env 파일에 본인의 API 키를 입력하세요.
OPENAI_API_KEY=

# LangSmith를 사용하지 않으면 false를 유지하세요.
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=capstone-all-total

# 필요한 경우 기본 모델 변경
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o
# OLLAMA_FAST_MODEL=qwen3:0.6b
# OLLAMA_QUALITY_MODEL=qwen3:8b

# TrendWeave 패션 분석 (기본 서비스)
SERVICE_MODE=trendweave
GOOGLE_API_KEY=
TAVILY_API_KEY=
TREND_MODEL=gemini-3.1-flash-lite
TREND_REQUESTS_PER_SECOND=0.25
TREND_MAX_WORKERS=1
# REPORT_DB_PATH=reports.db
# 기존 장애 대응 실습은 SERVICE_MODE=incident 로 실행
